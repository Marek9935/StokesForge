# Version lock of StokesForge's embedded Python stack (pitfall no. 6).
#
# These four values go together: numpy's ABI is tied to the CPython ABI
# (cp312), and rust-numpy is tied to a specific PyO3 version, itself compiled
# against this interpreter. NEVER change one without revalidating the others
# by rerunning scripts/python-vendor.sh then scripts/python-test.sh.
#
# `.env` format deliberately trivial (KEY=value, no quotes) so that it can be
# read both by bash (`source`) and by a human.

# CPython version of the python-build-standalone distribution.
PYTHON_VERSION=3.12.14

# Short version (X.Y), used for directory and library names.
PYTHON_XY=3.12

# Tag of the python-build-standalone (astral-sh) release, dated.
PBS_RELEASE=20260901

# Triple of the distribution. Linux here; under Windows (#332), the scripts
# (Git Bash) read PBS_TRIPLE_WINDOWS instead. License notices are per
# platform: vendor/python/licenses-linux and licenses-windows.
PBS_TRIPLE=x86_64-unknown-linux-gnu
PBS_TRIPLE_WINDOWS=x86_64-pc-windows-msvc

# Variant: `install_only_stripped` = shared distribution, ready to use,
# WITHOUT the native debug symbols of the binaries (libpython, python3, .so).
# Sharing (as opposed to a static `libpython`) remains MANDATORY: compiled
# extension modules (numpy) require a SHARED libpython (pitfall no. 3);
# stripping changes nothing about that, it only removes the symbols, not the
# fact that the library is loaded dynamically.
# Chosen (instead of `install_only`) because the unstripped `libpython3.12.so`
# alone weighs 209 MB out of the distribution's 307 MB; what we lose: native
# debugging of CPython itself (a call stack inside libpython no longer shows
# C function names). What we keep: Python tracebacks, error messages, file
# names and line numbers, all produced by the interpreter, not by native
# symbols.
PBS_FLAVOR=install_only_stripped

# numpy wheel pinned exactly (cp312, manylinux x86_64).
NUMPY_VERSION=2.5.3

# scipy wheel pinned exactly (cp312, manylinux x86_64), #191: offered to
# `pyst` scripts (`scipy.optimize.curve_fit`...), never used by the interface.
# Tied to numpy: the wheel requires `numpy>=2.0,<2.8` (checked for 1.18.1).
# It embeds its own native libraries (OpenBLAS, libgfortran, libquadmath in
# `scipy.libs/`): their notices are in its `LICENSE.txt`.
SCIPY_VERSION=1.18.1

# rust-numpy crate (bindings of the numpy C API), must match the PyO3 version.
RUST_NUMPY_VERSION=0.29.0

# PyO3 crate.
PYO3_VERSION=0.29.2
