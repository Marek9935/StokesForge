# Verrou de versions de la pile Python embarquée de StokesForge (piège n°6).
#
# Ces quatre valeurs sont solidaires : l'ABI de numpy est liée à l'ABI CPython
# (cp312), et rust-numpy est lié à une version précise de PyO3, elle-même
# compilée contre cet interpréteur. On ne change JAMAIS l'une sans revalider
# les autres en relançant scripts/python-vendor.sh puis scripts/python-test.sh.
#
# Format `.env` volontairement trivial (KEY=valeur, pas de guillemets) pour être
# lu à la fois par bash (`source`) et par un humain.

# Version CPython de la distribution python-build-standalone.
PYTHON_VERSION=3.12.14

# Version courte (X.Y) — sert aux noms de répertoires et de bibliothèques.
PYTHON_XY=3.12

# Étiquette de la release python-build-standalone (astral-sh), datée.
PBS_RELEASE=20260901

# Triplet de la distribution. Linux d'abord ; Windows = tâche 5.1b.
PBS_TRIPLE=x86_64-unknown-linux-gnu

# Variante : `install_only_stripped` = distribution partagée, prête à l'emploi,
# SANS les symboles de débogage natifs des binaires (libpython, python3, .so).
# Le partage (par opposition à un `libpython` statique) reste OBLIGATOIRE :
# les modules d'extension compilés (numpy) exigent une libpython PARTAGÉE
# (piège n°3) — le stripping ne change rien à ça, il retire seulement les
# symboles, pas le fait que la bibliothèque soit chargée dynamiquement.
# Choisie (au lieu de `install_only`) parce que `libpython3.12.so` non strippée
# pèse à elle seule 209 Mo sur les 307 Mo de la distribution ; ce qu'on perd :
# le débogage natif de CPython lui-même (une pile d'appel dans libpython
# n'affiche plus de noms de fonctions C). Ce qu'on garde : les tracebacks
# Python, messages d'erreur, noms de fichiers et numéros de ligne — produits
# par l'interpréteur, pas par les symboles natifs.
PBS_FLAVOR=install_only_stripped

# Roue numpy épinglée exactement (cp312, manylinux x86_64).
NUMPY_VERSION=2.5.3

# Crate rust-numpy (bindings de la C-API numpy), doit matcher la version de PyO3.
RUST_NUMPY_VERSION=0.29.0

# Crate PyO3.
PYO3_VERSION=0.29.2
