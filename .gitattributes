# The fingerprints of scripts/licenses-rust.sh cover bytes: never convert line
# endings (core.autocrlf on Windows would make them fail).
Cargo.lock text eol=lf
vendor/crate-license-notices/checksums.sha256 text eol=lf
vendor/crate-license-notices/NOTICE.txt -text
vendor/crate-license-notices/provenance.json -text
vendor/python/licenses-linux/** -text
vendor/python/licenses-windows/** -text

# Imported notices keep the whitespace and text endings of the originals.
vendor/crate-license-notices/NOTICE.txt whitespace=-blank-at-eol,-blank-at-eof
vendor/python/licenses-linux/LICENSE.libX11.txt whitespace=-blank-at-eof

# The witness files of the .stf format are binary.
*.stf binary
