{
  "permissions": {
    "allow": [
      "Bash(scripts/deliver.sh *)"
    ],
    "ask": [
      "Bash(git tag *)",
      "Bash(git push * --tags*)",
      "Bash(git push origin v*)"
    ],
    "deny": [
      "Bash(git stash)",
      "Bash(git stash *)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/suivi.py\" hook-news || true",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/suivi.py\" hook-news || true",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*suivi.py*)",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/suivi.py\" hook-wait",
            "asyncRewake": true,
            "timeout": 259200
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/scripts/suivi.py\" session-end",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
