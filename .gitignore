# Heavy test data
/sandbox/
*.h5
*.hdf5
*.pyst-project
# Projects saved by the test bench (`stokesforge-app [path]`): working
# saves, not fixtures — the versioned test sets live in `test/`.
*.stokesforge

# Vendored Python interpreter (python-build-standalone, see cahier-des-charges-technique.md §8.6.1)
/vendor/python/*.tar.gz
/vendor/python/extracted/

# Phosphor icons: only `SVGs/` (source of the embedded icons, see docs/icons.md)
# and `LICENSE` are versioned; the rest of the downloaded package is local.
/vendor/phosphor-icons/Fonts/
/vendor/phosphor-icons/PNGs/
/vendor/phosphor-icons/SVGs Flat/

