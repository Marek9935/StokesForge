# Rust
/target/
crates/*/target/

# Distributions assemblées (scripts/pyhello-dist.sh, cf. crates/stokesforge-python/README.md)
/dist/

# Python (legacy-python/ — gardé comme référence, cf. docs/rustrewrite/roadmap.md)
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.venv/
venv/

# Briefcase
/logs/
/macOS/
/windows/
/linux/

# Outils
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
coverage.xml
htmlcov/

# Éditeurs / OS
.vscode/
.idea/
*.swp
.DS_Store

# Données de test lourdes
/sandbox/
*.h5
*.hdf5
*.pyst-project
# Projets enregistrés par le banc (`stokesforge-app [chemin]`) : des sauvegardes de
# travail, pas des fixtures — les jeux d'essai versionnés vivent dans `test/`.
*.stokesforge

# Interpréteur Python vendored (python-build-standalone, cf. cahier-des-charges-technique.md §8.6.1)
/vendor/python/*.tar.gz
/vendor/python/extracted/

# Icônes Phosphor : seuls `SVGs/` (source des icônes embarquées, cf. docs/icones.md)
# et `LICENSE` sont versionnés ; le reste du paquet téléchargé est local.
/vendor/phosphor-icons/Fonts/
/vendor/phosphor-icons/PNGs/
/vendor/phosphor-icons/SVGs Flat/

