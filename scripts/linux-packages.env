# Linux RPM and DEB packages (#390), read by .github/workflows/ci.yml and the
# scripts/release-*.sh files.
# nfpm packs the assembled distribution into both formats (MIT licence, a build
# tool: not shipped, not a Cargo dependency). SHA-256 of
# nfpm_<version>_Linux_x86_64.tar.gz, from checksums.txt of the release.
NFPM_VERSION=2.47.0
NFPM_SHA256=0660ca602b2d2d2ae4781a06c692b3eeb9d437ffea05b831d76e41f4a3188783
# The single publication switch: 1 uploads the packages to the GitLab registry
# and links them to the release. Stays 0 until the icon (#388) is in the
# distribution; flip it in the commit that updates the manual and CHANGELOG.md.
# With 1 and no icon in the distribution, scripts/release-linux-packages.sh stops.
# (An environment value wins: the tests of scripts/linux-packages-test.sh use it.)
PUBLISH_LINUX_PACKAGES="${PUBLISH_LINUX_PACKAGES:-0}"
