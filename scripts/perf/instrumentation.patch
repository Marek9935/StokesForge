diff --git a/crates/stokesforge-app/src/app/prof.rs b/crates/stokesforge-app/src/app/prof.rs
new file mode 100644
index 00000000..55472c60
--- /dev/null
+++ b/crates/stokesforge-app/src/app/prof.rs
@@ -0,0 +1,91 @@
+//! TEMPORAIRE (mesure #340/#341) : chronomètres par étape, activés par `STOKESFORGE_PROF=1`.
+use std::cell::RefCell;
+use std::collections::BTreeMap;
+use std::time::{Duration, Instant};
+
+thread_local! {
+    static ACC: RefCell<BTreeMap<&'static str, (u32, Duration, Duration)>> = RefCell::new(BTreeMap::new());
+    static LAST_PRINT: RefCell<Option<Instant>> = const { RefCell::new(None) };
+    static LAST_FRAME: RefCell<Option<Instant>> = const { RefCell::new(None) };
+}
+
+fn on() -> bool {
+    static ON: std::sync::OnceLock<bool> = std::sync::OnceLock::new();
+    *ON.get_or_init(|| std::env::var_os("STOKESFORGE_PROF").is_some())
+}
+
+pub struct Span(&'static str, Instant);
+
+pub fn span(name: &'static str) -> Option<Span> {
+    on().then(|| Span(name, Instant::now()))
+}
+
+impl Drop for Span {
+    fn drop(&mut self) {
+        let d = self.1.elapsed();
+        ACC.with(|a| {
+            let mut a = a.borrow_mut();
+            let e = a.entry(self.0).or_default();
+            e.0 += 1;
+            e.1 += d;
+            e.2 = e.2.max(d);
+        });
+    }
+}
+
+/// Appelé en fin de `ui` : imprime le tableau chaque seconde.
+pub fn frame_end() {
+    if !on() {
+        return;
+    }
+    let now = Instant::now();
+    if let Some(prev) = LAST_FRAME.with(|l| l.replace(Some(now))) {
+        ACC.with(|a| {
+            let mut a = a.borrow_mut();
+            let e = a.entry("00 intervalle entre images").or_default();
+            let d = now - prev;
+            e.0 += 1;
+            e.1 += d;
+            e.2 = e.2.max(d);
+        });
+    }
+    let due = LAST_PRINT.with(|l| {
+        let mut l = l.borrow_mut();
+        match *l {
+            Some(t) if now - t < Duration::from_secs(2) => false,
+            _ => {
+                *l = Some(now);
+                true
+            }
+        }
+    });
+    if due {
+        ACC.with(|a| {
+            let mut a = a.borrow_mut();
+            eprintln!("--- PROF (2 s) : étape | n | moy ms | max ms | total ms");
+            for (k, (n, tot, max)) in a.iter() {
+                eprintln!(
+                    "PROF {k:<34} {n:>5} {:>8.3} {:>8.3} {:>9.1}",
+                    tot.as_secs_f64() * 1e3 / f64::from(*n),
+                    max.as_secs_f64() * 1e3,
+                    tot.as_secs_f64() * 1e3
+                );
+            }
+            a.clear();
+        });
+    }
+}
+
+pub fn record(name: &'static str, secs: f32) {
+    if !on() {
+        return;
+    }
+    let d = Duration::from_secs_f32(secs);
+    ACC.with(|a| {
+        let mut a = a.borrow_mut();
+        let e = a.entry(name).or_default();
+        e.0 += 1;
+        e.1 += d;
+        e.2 = e.2.max(d);
+    });
+}
